# Merge these hooks into ~/.kimi-code/config.toml when using Kimi CLI in this
# repo. The hook commands are RELATIVE paths — Kimi resolves them against the
# project cwd, so the global registration works across repos. Repos that don't
# vendor .kimi/hooks/adapter.sh get silent no-ops; repos that vendor the
# adapter but lack a given policy get a silent exit 0 from the adapter's
# missing-policy guard. One global registration serves the whole fleet.
#
# Matchers are regexes over Kimi's tool names (Kimi >= 0.29: Bash, Write,
# Edit, Agent, AgentSwarm, WebSearch, FetchURL — the pre-0.29 names
# Shell/WriteFile/StrReplaceFile match nothing).
#
# Hook policy lives in .agents/hooks/policy/ (engine-agnostic).
# .kimi/hooks/adapter.sh normalizes Kimi's stdin into the policy contract —
# see the seam list in its header (verified against Kimi 0.29): PostToolUse
# findings relay through Stop, additionalContext envelopes unwrap to plain
# stdout, UserPromptSubmit's prompt array joins to a string, PostCompact
# maps to session-start.sh with source=compact, and session_id keys the
# wrap throttle (state in .agents/.wrap-state-*, same as Claude).
#
# Still not portable: stop-investigate (Kimi's Stop payload has no
# transcript path or last-message field). The no-diff investigation report
# inside session-wrap also stays Claude-only (needs a transcript to size
# the session); the wrap's diff ladder works fully under Kimi.
#
# PreCompact/PostCompact payload shapes are unverified (compaction can't be
# forced in a short probe); both hooks fail open and the marker protocol
# defaults trigger=auto. SubagentStart is unused — genome-guard rides
# PreToolUse on Agent|AgentSwarm, which is blockable and schema-verified.

# MCP servers: the registry lives in .agents/mcp.json; per-repo toggles in
# .agents/config.json (mcp.servers.<name>.enabled). .agents/sync-mcp.sh
# generates .kimi-code/mcp.json (Kimi's native project-level path — Kimi
# 0.29+ auto-discovers it, no launch flag) and .mcp.json for Claude.
# Both are gitignored build output — never hand-edit them.
# (AGENTS.md and .agents/skills/ are already read natively by Kimi.)

# Progressive tool disclosure (Kimi >= 0.23, experimental): keeps MCP tool
# schemas out of the upfront context; the model loads them on demand via a
# select_tools tool. Two config keys, both required:
#   [experimental]
#   tool-select = true
# and the model must declare the capability — add "dynamically_loaded_tools"
# to the model's `capabilities` array (unioned, never removed). K3 supports
# it (API-level dynamic loading is kimi-k3 only). If the capability is not
# declared the flag is inert. Claude Code equivalent: ENABLE_TOOL_SEARCH in
# .claude/settings.json `env` (this repo sets "auto:5" — load upfront
# while schemas fit under 5% of context, defer the overflow).

[[hooks]]
event = "PreToolUse"
matcher = "Bash"
command = ".kimi/hooks/adapter.sh guard-destructive.sh"
timeout = 10

[[hooks]]
event = "PreToolUse"
matcher = "Agent|AgentSwarm"
command = ".kimi/hooks/adapter.sh genome-guard.sh"
timeout = 10

[[hooks]]
event = "PostToolUse"
matcher = "Write|Edit"
command = ".kimi/hooks/adapter.sh post-edit-check.sh"
timeout = 30

[[hooks]]
event = "PostToolUse"
matcher = "WebSearch|FetchURL"
command = ".kimi/hooks/adapter.sh sources-capture.sh"
timeout = 10

[[hooks]]
event = "SessionStart"
command = ".kimi/hooks/adapter.sh session-start.sh"
timeout = 10

[[hooks]]
event = "UserPromptSubmit"
command = ".kimi/hooks/adapter.sh research-prime.sh"
timeout = 10

[[hooks]]
event = "PreCompact"
command = ".kimi/hooks/adapter.sh pre-compact.sh"
timeout = 10

[[hooks]]
event = "PostCompact"
command = ".kimi/hooks/adapter.sh session-start.sh"
timeout = 10

[[hooks]]
event = "Stop"
command = ".kimi/hooks/adapter.sh session-wrap.sh"
timeout = 10
