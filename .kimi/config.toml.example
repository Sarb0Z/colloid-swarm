# Merge these hooks into ~/.kimi-code/config.toml when using Kimi CLI in this
# repo. The hook commands are RELATIVE paths — Kimi resolves them against the
# project cwd, so the global registration works across repos, but ONLY in
# repos that vendor .kimi/hooks/adapter.sh; anywhere else the hooks silently
# do nothing.
#
# Hook policy lives in .agents/hooks/policy/ (engine-agnostic).
# .kimi/hooks/adapter.sh normalizes Kimi's stdin into the policy contract.
#
# Matchers are regexes over Kimi's tool names (Kimi >= 0.29: Bash, Write,
# Edit — the pre-0.29 names Shell/WriteFile/StrReplaceFile match nothing).
#
# The transcript-based stop-investigate hook is omitted: Kimi's Stop payload
# exposes no transcript path or last-message field, so a faithful port is
# not possible today.
#
# The genome-guard hook is omitted too — but for a different reason. The
# emitter (.agents/genome.sh) is engine-neutral, so the orchestrator protocol
# (stamp a genome onto each dispatched subagent) works under Kimi natively.
# Only the *enforcement* guard is Claude-wired. Kimi >= 0.29 fires
# SubagentStart (and its dispatch tools are Agent/AgentSwarm, matchable on
# PreToolUse); porting the guard needs a [[hooks]] block pointing at
# `.kimi/hooks/adapter.sh genome-guard.sh` plus an adapter branch mapping
# {prompt, subagent_type} — unwritten, see breadcrumbs.
#
# The search scaffold degrades partway. The researcher cell
# (.agents/researcher.md) and the search-and-cite skill are engine-neutral and
# work natively. sources-capture needs Kimi's web-tool names mapped (a
# PostToolUse matcher on WebSearch/FetchURL + an adapter branch for
# {tool_name -> kind, value}); research-prime needs a UserPromptSubmit block —
# Kimi >= 0.29 exposes both events, but the ports are unwritten (see
# breadcrumbs). Until then the evidence trail and the prime are Claude-only.

# MCP servers: this repo's servers (context7, playwright) live in
# .agents/mcp.json — the same `mcpServers` JSON Claude loads via .mcp.json.
# Kimi has no repo-level MCP auto-discovery, so launch it with that file:
#     kimi --mcp-config-file .agents/mcp.json
# The flag is CLI-only (not a config.toml key) — nothing to merge here.
# (AGENTS.md and .agents/skills/ are already read natively by Kimi.)

[[hooks]]
event = "PreToolUse"
matcher = "Bash"
command = ".kimi/hooks/adapter.sh guard-destructive.sh"
timeout = 10

[[hooks]]
event = "PostToolUse"
matcher = "Write|Edit"
command = ".kimi/hooks/adapter.sh post-edit-check.sh"
timeout = 30

[[hooks]]
event = "Stop"
command = ".kimi/hooks/adapter.sh session-wrap.sh"
timeout = 10
