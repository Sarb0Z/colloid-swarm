      "enabled": true
    },
    "genome_guard": {
      "enabled": true
    },
    "sources_capture": {
      "enabled": true
    },
    "research_prime": {
      "enabled": true
    },
    "post_edit_check": {
      "enabled": true
    },
    "session_wrap": {
      "enabled": true,
