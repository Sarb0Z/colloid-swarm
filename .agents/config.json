    "default_register": "panspermia",
    "exempt_subagent_types": [
      "explore",
      "plan",
      "claude-code-guide",
      "statusline-setup",
      "learning-reporter"
    ]
  },
  "models": {
    "researcher": "sonnet",
    "learning_reporter": null,
    "explore": null,
    "plan": null,
    "default_subagent": null
