{
  "swarm": {
    "genome_stamping": true,
    "default_register": "panspermia",
    "exempt_subagent_types": [
      "explore",
      "plan",
      "claude-code-guide",
      "statusline-setup",
      "learning-reporter"
    ]
  },
  "mcp": {
    "servers": {
      "context7": {
        "enabled": true,
        "description": "up-to-date library/framework docs lookup (2 tools)"
      },
      "playwright": {
        "enabled": true,
        "description": "browser automation for web E2E and UI verification (~24 tools)"
      },
      "playwright-reader": {
        "enabled": false,
        "description": "reading tier — Chrome for Testing with content blocking, for research fetches (~24 tools; run .agents/fetch-extension.sh ublock-lite first)"
      },
      "appium-mcp": {
        "enabled": true,
        "description": "mobile app automation — drive the app, inspect the UI, verify on device/simulator (~31 tools)"
      },
      "security-mcp": {
        "enabled": false,
        "description": "repository-owned authorized security scanning (3 tools)"
      },
      "research-mcp": {
        "enabled": true,
        "description": "repository-owned web reading — article/PDF extraction and open-access resolution (2 tools; set RESEARCH_MCP_CONTACT_EMAIL to enable Unpaywall)"
      },
      "linear": {
        "enabled": true,
        "description": "Linear issue tracking (HTTP, OAuth login on first use)"
      },
      "atlassian": {
        "enabled": true,
        "codex_enabled": false,
        "description": "Jira, Confluence, Bitbucket via Atlassian Rovo MCP (SSE, OAuth login on first use)"
      },
      "greptile": {
        "enabled": false,
        "description": "codebase Q&A and review via Greptile (HTTP, needs GREPTILE_API_KEY)"
      },
      "exa": {
        "enabled": false,
        "codex_enabled": false,
        "description": "web search and fetch via Exa (HTTP, needs EXA_API_KEY)"
      }
    }
  },
  "models": {
    "researcher": "sonnet",
    "learning_reporter": null,
    "explore": null,
    "plan": null,
    "default_subagent": null
  },
  "hooks": {
    "guard_destructive": {
      "enabled": true
    },
    "grader_lock": {
      "enabled": true
    },
    "genome_guard": {
      "enabled": true
    },
    "genome_inject": {
      "enabled": true
    },
    "sources_capture": {
      "enabled": true
    },
    "research_prime": {
      "enabled": true
    },
    "post_edit_check": {
      "enabled": true,
      "tombstone_check": true,
      "nullsafety_check": true
    },
    "session_wrap": {
      "enabled": true,
      "trivial_files": 2,
      "trivial_lines": 30,
      "review_files": 5,
      "review_lines": 150,
      "heavy_lines": 200,
      "report_every_turn": false
    },
    "stop_investigate": {
      "enabled": true,
      "ratchet_check": true
    },
    "learning_report": {
      "enabled": false
    },
    "learning_output_style": {
      "enabled": true
    },
    "session_start": {
      "enabled": true
    },
    "pre_compact": {
      "enabled": true
    }
  }
}
