{
  "swarm": {
    "genome_stamping": true,
    "default_register": "panspermia",
    "exempt_subagent_types": [
      "explore",
      "plan",
      "claude-code-guide",
      "statusline-setup",
      "learning-reporter"
    ]
  },
  "mcp": {
    "servers": {
      "context7": {
        "enabled": true,
        "description": "up-to-date library/framework docs lookup (2 tools)"
      },
      "playwright": {
        "enabled": true,
        "description": "browser automation for web E2E and UI verification (~24 tools)"
      },
      "playwright-reader": {
        "enabled": false,
        "description": "reading tier — Chrome for Testing with content blocking, for research fetches (~24 tools; run .agents/fetch-extension.sh ublock-lite first)"
      },
      "appium-mcp": {
        "enabled": false,
        "description": "on-demand mobile app automation — drive the app, inspect the UI, verify on device/simulator (~31 tools)"
      },
      "security-mcp": {
        "enabled": false,
        "description": "repository-owned authorized security scanning (3 tools)"
      },
      "research-mcp": {
        "enabled": true,
        "description": "repository-owned web reading — article/PDF extraction and open-access resolution (2 tools; set RESEARCH_MCP_CONTACT_EMAIL to enable Unpaywall)"
      },
      "linear": {
        "enabled": false,
        "description": "on-demand Linear issue tracking (HTTP, OAuth login on first use)"
      },
      "atlassian": {
        "enabled": false,
        "codex_enabled": false,
        "description": "on-demand Jira, Confluence, Bitbucket via Atlassian Rovo MCP (SSE, OAuth login on first use)"
      },
      "greptile": {
        "enabled": false,
        "description": "codebase Q&A and review via Greptile (HTTP, needs GREPTILE_API_KEY)"
      },
      "exa": {
        "enabled": false,
        "codex_enabled": false,
        "description": "web search and fetch via Exa (HTTP, needs EXA_API_KEY)"
      }
    }
  },
  "stack_packs": {
    "carrier": true
  },
  "tiers": {
    "heavy": {
      "claude": "opus",
      "codex": "gpt-5.6-sol",
      "codex_effort": "high"
    },
    "medium": {
      "claude": "sonnet",
      "codex": "gpt-5.6-terra",
      "codex_effort": "medium"
    },
    "light": {
      "claude": "haiku",
      "codex": "gpt-5.6-luna",
      "codex_effort": "low"
    }
  },
  "subagents": {
    "implementer": {
      "tier": "medium",
      "effort": "medium",
      "tools": ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
      "permission_mode": "acceptEdits",
      "max_turns": 30
    },
    "mechanic": {
      "tier": "light",
      "tools": ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
      "permission_mode": "acceptEdits",
      "max_turns": 12
    },
    "explorer": {
      "tier": "light",
      "tools": ["Read", "Glob", "Grep"],
      "max_turns": 16
    },
    "qa-verifier": {
      "tier": "medium",
      "effort": "medium",
      "tools": ["Read", "Glob", "Grep", "Bash", "mcp__playwright__*"],
      "mcp_servers": ["playwright"],
      "max_turns": 20
    },
    "reviewer": {
      "tier": "heavy",
      "effort": "high",
      "tools": ["Read", "Glob", "Grep", "Bash"],
      "max_turns": 24
    },
    "researcher": {
      "tier": "medium",
      "effort": "medium",
      "tools": ["Read", "Grep", "Glob", "WebSearch", "WebFetch", "mcp__context7__*", "mcp__research-mcp__*"],
      "mcp_servers": ["context7", "research-mcp"],
      "max_turns": 20,
      "memory": null
    },
    "learning-reporter": {
      "tier": null,
      "effort": null,
      "tools": ["Bash", "Read", "Write"],
      "memory": null
    }
  },
  "hooks": {
    "guard_destructive": {
      "enabled": true
    },
    "grader_lock": {
      "enabled": true
    },
    "genome_inject": {
      "enabled": true
    },
    "sources_capture": {
      "enabled": true
    },
    "research_prime": {
      "enabled": true
    },
    "post_edit_check": {
      "enabled": true,
      "tombstone_check": true,
      "nullsafety_check": true
    },
    "session_wrap": {
      "enabled": true,
      "trivial_files": 2,
      "trivial_lines": 30,
      "review_files": 5,
      "review_lines": 150,
      "heavy_lines": 200,
      "report_every_turn": false
    },
    "stop_investigate": {
      "enabled": true,
      "ratchet_check": true
    },
    "learning_report": {
      "enabled": false
    },
    "learning_output_style": {
      "enabled": true
    },
    "session_start": {
      "enabled": true
    },
    "pre_compact": {
      "enabled": true
    }
  }
}
