{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "outputStyle": "colloid",
  "permissions": {
    "ask": [
      "Artifact",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr lock:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh release create:*)",
      "Bash(gh release upload:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release edit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh gist create:*)",
      "Bash(gh gist edit:*)",
      "Bash(gh gist delete:*)",
      "Bash(gh workflow run:*)",
      "Bash(npm publish:*)",
      "Bash(npm unpublish:*)",
      "Bash(pnpm publish:*)",
      "Bash(pnpm unpublish:*)",
      "Bash(yarn publish:*)",
      "Bash(yarn unpublish:*)",
      "Bash(yarn npm publish:*)",
      "Bash(bun publish:*)",
      "Bash(bun unpublish:*)",
      "Bash(docker push:*)",
      "Bash(vercel:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel promote:*)",
      "Bash(vercel rollback:*)",
      "Bash(vercel alias:*)",
      "Bash(vercel rm:*)",
      "Bash(vercel remove:*)",
      "Bash(vercel redeploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(netlify deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler publish:*)",
      "Bash(firebase deploy:*)",
      "Bash(fly deploy:*)",
      "Bash(flyctl deploy:*)",
      "Bash(railway up:*)",
      "Bash(railway deploy:*)",
      "Bash(npx vercel:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx netlify deploy:*)",
      "Bash(npx firebase deploy:*)",
      "Bash(npx fly deploy:*)",
      "Bash(vercel)",
      "mcp__linear",
      "mcp__atlassian",
      "mcp__plugin_vercel_vercel__*",
      "mcp__claude_ai_Slack__*",
      "mcp__claude_ai_Google_Drive__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh guard-destructive.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh guard-publish.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh genome-inject.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "POST_EDIT_MODE=write $CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh post-edit-check.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh post-edit-check.sh",
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh ui-gate.sh"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|mcp__playwright__browser_navigate|mcp__playwright-reader__browser_navigate|mcp__plugin_playwright_playwright__browser_navigate|mcp__research-mcp__fetch_readable|mcp__research-mcp__resolve_open_access|mcp__context7__(resolve-library-id|query-docs)|mcp__plugin_context7_context7__(resolve-library-id|query-docs)|mcp__plugin_exa_exa__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh sources-capture.sh"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_take_screenshot|mcp__plugin_playwright_playwright__browser_take_screenshot|mcp__playwright-reader__browser_take_screenshot|mcp__claude-in-chrome__.*screenshot.*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh ui-gate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh --agent main stop-investigate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh --agent main ui-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh --agent main session-wrap.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh --agent main session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh --agent main research-prime.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh --agent main done-prime.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter.sh --agent main pre-compact.sh"
          }
        ]
      }
    ]
  }
}
