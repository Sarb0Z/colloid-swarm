{
  "mcpServers": {
    "context7": {
      "description": "Current library and framework documentation.",
      "sources": ["resolve-library-id", "query-docs"],
      "enabled": true,
      "codex_startup_timeout_sec": 30,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "description": "Browser automation and UI verification.",
      "sources": ["browser_navigate"],
      "enabled": true,
      "codex_startup_timeout_sec": 30,
      "type": "stdio",
      "command": "python3",
      "args": [
        "${REPO_ROOT}/.agents/playwright-session.py",
        "npx",
        "-y",
        "@playwright/mcp@0.0.84",
        "--config",
        "${REPO_ROOT}/.agents/.browser/playwright.json"
      ]
    },
    "playwright-reader": {
      "description": "Browser reading with installed content-blocking extensions.",
      "sources": ["browser_navigate"],
      "enabled": false,
      "type": "stdio",
      "command": "python3",
      "args": [
        "${REPO_ROOT}/.agents/playwright-session.py",
        "npx",
        "-y",
        "@playwright/mcp@0.0.84",
        "--config",
        "${REPO_ROOT}/.agents/.playwright-reader.json"
      ]
    },
    "scrapling": {
      "description": "Stealth browser for bot-walled pages, including Cloudflare's interactive checkbox. Claude only. Install its browser once: uvx --python 3.12 --exclude-newer 2026-11-09T00:00:00Z --from 'scrapling[ai]==0.5.1' scrapling install",
      "sources": ["browser_fetch_once", "browser_fetch"],
      "enabled": false,
      "hosts": ["claude", "opencode"],
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--exclude-newer",
        "2026-11-09T00:00:00Z",
        "--from",
        "scrapling[ai]==0.5.1",
        "python",
        "-I",
        "${REPO_ROOT}/.agents/scrapling-mcp.py"
      ]
    },
    "appium-mcp": {
      "description": "Mobile app automation.",
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "appium-mcp"
      ]
    },
    "security-mcp": {
      "description": "Repository-owned authorized security scanning.",
      "enabled": false,
      "type": "stdio",
      "command": "node",
      "args": [
        "${REPO_ROOT}/.agents/mcp-servers/security-mcp/dist/server.js"
      ],
      "cwd": "${REPO_ROOT}/.agents/mcp-servers/security-mcp"
    },
    "research-mcp": {
      "description": "Repository-owned web and PDF research tools.",
      "sources": ["fetch_readable", "resolve_open_access"],
      "enabled": true,
      "type": "stdio",
      "command": "node",
      "args": [
        "${REPO_ROOT}/.agents/mcp-servers/research-mcp/dist/server.js"
      ],
      "cwd": "${REPO_ROOT}/.agents/mcp-servers/research-mcp"
    },
    "linear": {
      "description": "Linear issue tracking.",
      "enabled": false,
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "outward": true
    },
    "atlassian": {
      "description": "Jira, Confluence, and Bitbucket via Atlassian Rovo.",
      "enabled": false,
      "hosts": ["claude", "kimi"],
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/sse",
      "outward": true
    },
    "greptile": {
      "description": "Codebase Q&A and review.",
      "sources": ["*"],
      "enabled": false,
      "type": "http",
      "url": "https://api.greptile.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GREPTILE_API_KEY}"
      }
    },
    "exa": {
      "description": "Web search and fetch.",
      "sources": ["*"],
      "enabled": false,
      "hosts": ["claude", "kimi", "opencode"],
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}"
    }
  }
}
