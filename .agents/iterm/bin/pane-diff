#!/usr/bin/env bash
# Open Neovim's diffview on the files not pushed yet.
#   pane-diff [<base>] [-- <file>]
# <base> HEAD (iTerm2's default) means pane-base's "not pushed" commit; @ means
# uncommitted changes only; anything else is passed through as typed.
set -uo pipefail

# Neovim: PATH first, then the Linux and Homebrew locations, since a pane's PATH
# (a tmux server's on Linux, a non-login shell's on macOS) may lack it.
# PANE_DIFF_NVIM overrides.
find_nvim() {
  command -v nvim && return
  local path
  for path in /usr/bin/nvim /opt/homebrew/bin/nvim; do
    [[ -x $path ]] && { echo "$path"; return; }
  done
  echo /opt/homebrew/bin/nvim
}
nvim=${PANE_DIFF_NVIM:-$(find_nvim)}
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# The pane would close at once on an error, so every failure holds it for a key.
fail() {
  printf 'pane-diff: %s\n' "$1" >&2
  echo "Press any key to close." >&2
  read -rsn1 || true
  exit 1
}

base=HEAD
if [[ $# -gt 0 && $1 != -- ]]; then
  base=$1
  shift
fi
file=
if [[ $# -gt 0 ]]; then
  [[ $# -eq 2 && $1 == -- ]] || fail "usage: pane-diff [<base>] [-- <file>]"
  file=$2
fi

git rev-parse --git-dir >/dev/null 2>&1 || fail "$PWD is not inside a git repository"

if [[ $base == HEAD ]]; then
  # pane-base prints its reason on stderr, then the hash on stdout.
  resolved=$("$here/pane-base" 2>&1) || fail "$resolved"
  base=${resolved##*$'\n'}
fi

# Backslash-escape what diffview's argument tokenizer reads as syntax:
# whitespace, quotes and backslash. A path argument then goes through Vim's
# expand(), which also reads % # [ ] * ? { } ~ $ and ` as syntax.
escape_arg() {
  printf '%s' "$1" | sed 's/[[:space:]"'"'"'\\]/\\&/g'
}
escape_path() {
  printf '%s' "$1" | sed 's/[][[:space:]"'"'"'\\%#*?{}$`~]/\\&/g'
}

suffix=
[[ -n $file ]] && suffix=" -- $(escape_path "$file")"

if [[ $base == @ ]]; then
  exec "$nvim" -c "DiffviewOpen$suffix"
fi

# Diffview lists untracked files only for index-against-working-tree, so a
# commit base would hide them. When any exist, a second tab shows that view.
untracked=$(git --literal-pathspecs ls-files -z --others --exclude-standard ${file:+-- "$file"} | tr -cd '\0' | wc -c | tr -d ' ')
if ((untracked == 0)); then
  exec "$nvim" -c "DiffviewOpen $(escape_arg "$base")$suffix"
fi

# Each DiffviewOpen opens its own tab after the empty startup tab, which is closed.
noun=files
((untracked == 1)) && noun=file
exec "$nvim" \
  -c "DiffviewOpen $(escape_arg "$base")$suffix" \
  -c "DiffviewOpen$suffix" \
  -c "1tabclose" \
  -c "tabfirst" \
  -c "echomsg '$untracked untracked $noun: see tab 2 (gt)'"
