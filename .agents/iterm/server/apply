#!/usr/bin/env bash
# Run setup-server.sh on contabo-hop as root, from the Mac (TERMINAL-SPEC.md Unit 5).
# It sends this folder, the Mac's public key and the Mac's Claude Code version over
# one ssh connection, runs the script in a scratch folder there, and removes it;
# then, logged in as openclawops (contabo-dev), it clones colloid-swarm if absent.
#
# Besides this folder it stages what only the Mac has (never committed): the device
# policy and account payloads from /Library/Application Support/ClaudeCode, the
# colloid output style, the git identity registry and ~/.claude/skills.
# CLAUDE_DEVICE_DIR, GIT_IDENTITIES and CLAUDE_SKILLS_DIR move those sources; only
# the tests set them.
#
# Usage: apply [--check]
#   --check  print each change a run would make; change nothing
set -euo pipefail

mode=
case ${1:-} in
  "") ;;
  --check) mode=--check ;;
  *)
    echo "usage: apply [--check]" >&2
    exit 2
    ;;
esac
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
key=$HOME/.ssh/id_ed25519.pub
[[ -r $key ]] || {
  echo "apply: no public key at $key" >&2
  exit 1
}
version=$(command claude --version | awk '{ print $1 }')
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "apply: could not read the Mac's Claude Code version (got '$version')" >&2
  exit 1
}

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cp "$here/setup-server.sh" "$here/tmux.conf" "$here/launchers.bash" "$here/settings.json" "$here/github-known-hosts" "$here/tailscale-archive-keyring.asc" "$stage/"
cp "$key" "$stage/mac.pub"
printf '%s\n' "$version" >"$stage/claude-version"
cp "$here/managed-settings.json" "$here/policy-helper.sh" "$here/server-asks.json" "$here/claude-statusline.sh" \
  "$here/CLAUDE.md" "$here/gitconfig-projects" "$here/colloid-diffview.lua" "$stage/"

# What only the Mac has, copied at apply time and never committed: the device
# policy and its per-account payloads (named by email), the colloid output style,
# the git identity registry without its key paths, and the skills.
device=${CLAUDE_DEVICE_DIR:-/Library/Application Support/ClaudeCode}
[[ -f $device/policy.json ]] || {
  echo "apply: no device policy at $device/policy.json" >&2
  exit 1
}
cp "$device/policy.json" "$stage/policy.json"
if [[ -d $device/accounts ]]; then
  mkdir "$stage/accounts"
  cp "$device"/accounts/*.json "$stage/accounts/"
fi
# cp follows the link, so the style is the repository's file, not the link.
cp "$here/../../claude/output-style.md" "$stage/output-style.md"
registry=${GIT_IDENTITIES:-$HOME/.config/git-identities.json}
[[ -f $registry ]] || {
  echo "apply: no git identity registry at $registry" >&2
  exit 1
}
jq '{identities: (.identities | map_values({name, email, github_org}))}' "$registry" >"$stage/git-identities.json"

# Skills: each folder of ~/.claude/skills that is not a link into a repository,
# links inside it followed, and none over 5 MB.
skills=${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}
mkdir "$stage/skills"
for skill in "$skills"/*/; do
  [[ -d $skill ]] || continue
  name=$(basename "$skill")
  if [[ -L ${skill%/} ]] && git -C "$skill" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "apply: skill $name is a link into a repository; not sent"
    continue
  fi
  kb=$(du -skL "$skill" | awk '{ print $1 }')
  if ((kb > 5120)); then
    echo "apply: skill $name is ${kb} KB, over 5 MB; not sent"
    continue
  fi
  cp -RL "${skill%/}" "$stage/skills/$name"
done

# GNU tar on the server warns on each macOS file tag (com.apple.provenance) it
# finds; --no-xattrs keeps the tags out, and the other two the AppleDouble copies.
COPYFILE_DISABLE=1 tar --no-mac-metadata --no-xattrs -cf - -C "$stage" . |
  ssh contabo-hop 'd=$(mktemp -d) && tar -xf - -C "$d" && bash "$d/setup-server.sh" '"$mode"' "$d/mac.pub"; s=$?; rm -rf "$d"; exit $s'

# colloid-swarm in openclawops' ~/Projects, cloned over ssh with the Mac's key,
# which a throwaway agent forwards for this one login; nothing stays on the server.
# The clone runs without the global git config, so the https rewrite in
# ~/.gitconfig-projects cannot turn its ssh url into one that needs a gh login.
origin=$(git -C "$here" remote get-url origin)
slug=${origin#git@github.com:}
slug=${slug#https://*github.com/}
slug=${slug%.git}
[[ $slug =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
  echo "apply: the checkout's origin ($origin) names no GitHub repository" >&2
  exit 1
}
clone=Projects/colloid-swarm
present=0
ssh contabo-dev "test -d ~/$clone/.git" || present=$?
if ((present == 0)); then
  echo "colloid-swarm is already in ~/$clone"
elif ((present != 1)); then
  echo "apply: could not log in to contabo-dev to look for ~/$clone (ssh exit $present)" >&2
  exit 1
elif [[ $mode == --check ]]; then
  echo "would: clone git@github.com:$slug.git into openclawops' ~/$clone with the Mac's forwarded key"
else
  echo "do:    clone git@github.com:$slug.git into openclawops' ~/$clone with the Mac's forwarded key"
  eval "$(ssh-agent -s)" >/dev/null
  trap 'ssh-agent -k >/dev/null; rm -rf "$stage"' EXIT
  ssh-add -q "${key%.pub}"
  ssh -A contabo-dev "GIT_CONFIG_GLOBAL=/dev/null git clone -q git@github.com:$slug.git ~/$clone" || {
    echo "apply: GitHub refused the clone; add the Mac's key to the account that owns $slug: gh ssh-key add $key" >&2
    exit 1
  }
fi
