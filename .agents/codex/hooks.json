{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" guard-destructive.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" genome-inject.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "POST_EDIT_MODE=write bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" post-edit-check.sh"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" post-edit-check.sh"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_navigate|mcp__playwright-reader__browser_navigate|mcp__plugin_playwright_playwright__browser_navigate|mcp__research-mcp__fetch_readable|mcp__research-mcp__resolve_open_access|mcp__context7__(resolve-library-id|query-docs)|mcp__plugin_context7_context7__(resolve-library-id|query-docs)|mcp__plugin_exa_exa__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" sources-capture.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" pre-compact.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" research-prime.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" stop-investigate.sh"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adapter.sh\" session-wrap.sh"
          }
        ]
      }
    ]
  }
}
