+def _sqlstate(exc: BaseException) -> str | None:
+    """Best-effort PostgreSQL SQLSTATE from a SQLAlchemy/asyncpg exception."""
+    orig = getattr(exc, "orig", None)
+    for obj in (exc, orig, getattr(orig, "__cause__", None)):
+        code = getattr(obj, "sqlstate", None) or getattr(obj, "pgcode", None)
+        if code:
+            return str(code)
+    return None
+
