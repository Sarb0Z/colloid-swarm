#!/bin/bash
# commit-msg: every commit carries a canonical
# `Authored-By: <login> <noreply-email>` trailer matching the
# gh-authenticated GitHub identity for this repo. Adds it when missing,
# replaces a wrong value, and normalizes attribution variants (`By:`,
# `Authored By:`, `Co-Authored-By:`, any case) into it. Git trailer tokens
# admit only alphanumerics and `-`, so the token is hyphenated; a space
# would make git read the whole line as one valueless token.
# Fail open: an unavailable identity or a failed rewrite never
# blocks the commit. Known gap: cherry-pick and rebase replay commits
# without running commit-msg; those messages pass through unchanged.
#
# Wiring (once per clone): git config core.hooksPath .githooks
# Identity resolution: $AUTHORED_BY_IDENTITY env override, else a cache in
# the common .git dir (refreshed from `gh api user` when older than 7
# days; delete the cache to force a refresh), else live gh.
# debt: githook-variant-strip-anywhere

msg_file="$1"

# fixup!/squash! messages must stay byte-identical for --autosquash matching
case "$(head -n1 "$msg_file")" in
  fixup!*|squash!*) exit 0 ;;
esac

# An effectively empty message must stay empty so git's own
# abort-on-empty check still fires; a trailer would defeat it.
# Comment lines are per core.commentChar, not a hardcoded '#'.
cc=$(git config --get core.commentChar 2>/dev/null)
case "$cc" in ''|auto) cc='#' ;; esac
awk -v c="$cc" 'substr($0, 1, length(c)) != c && $0 !~ /^[[:space:]]*$/ \
  {found = 1; exit} END {exit found ? 0 : 1}' "$msg_file" || exit 0

git_dir=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
cache="$git_dir/authored-by-identity"
identity="${AUTHORED_BY_IDENTITY:-}"

if [ -z "$identity" ] && [ -f "$cache" ] \
   && [ -n "$(find "$cache" -mtime -7 2>/dev/null)" ]; then
  identity=$(head -n1 "$cache")
fi

if [ -z "$identity" ]; then
  fresh=$(gh api user \
    --jq '"\(.login) <\(.id)+\(.login)@users.noreply.github.com>"' 2>/dev/null)
  if [ -n "$fresh" ]; then
    identity="$fresh"
    printf '%s\n' "$identity" > "$cache.tmp" && mv "$cache.tmp" "$cache"
  elif [ -f "$cache" ]; then
    identity=$(head -n1 "$cache")   # stale cache beats no identity
    touch "$cache"                  # bound refresh retries to once per TTL
  fi
fi

if [ -z "$identity" ]; then
  echo "commit-msg: gh identity unavailable — Authored-By: trailer skipped" >&2
  exit 0
fi

# Strip attribution variants and existing Authored-By: lines; the canonical
# trailer below replaces them. Self-stripping lets interpret-trailers run in
# `add` mode, whose token matching cannot eat unrelated `Authored-By*`
# trailers the way `replace` prefix-matching does. grep -v + mv, not sed -i
# (BSD/GNU).
if grep -qiE '^((co-)?authored[- ]by:|by:)' "$msg_file"; then
  grep -viE '^((co-)?authored[- ]by:|by:)' "$msg_file" > "$msg_file.authored-by" \
    && mv "$msg_file.authored-by" "$msg_file"
fi

git interpret-trailers --in-place --no-divider --if-exists add \
  --trailer "Authored-By: $identity" "$msg_file" 2>/dev/null || true
exit 0
