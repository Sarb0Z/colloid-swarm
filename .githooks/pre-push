#!/bin/bash
# pre-push: refuse a push when any commit it sends carries a private name, or
# when a name on this machine is in no list. git passes the remote name and URL
# as arguments and the refs on stdin, which `push` reads.
exec python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../.agents/leak_gate.py" push "$@"
