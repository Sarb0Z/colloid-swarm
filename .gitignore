# Transient hook state — regenerated at runtime, never committed.
.agents/.genome-ledger
.agents/.mutagen-ledger
.agents/.sources-ledger
.agents/.compaction-pending
.agents/.wrap-state-*

# Per-operator local config and secrets (carry the framework, not the keys).
**/settings.local.json
.env
.env.*

# Python bytecode.
__pycache__/

# Local, per-repo tuned config — copy from config.json.example and tune
.agents/config.json

# per-workspace scratch typecheck cache written by post-edit-check.sh
**/.tsbuildinfo-claude
