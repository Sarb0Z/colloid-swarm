# Transient hook state — regenerated at runtime, never committed.
.agents/.genome-ledger
.agents/.mutagen-ledger
.agents/.sources-ledger
.agents/.compaction-pending
.agents/.wrap-state-*
.agents/.wrap-edits-*
.agents/.wrap-commits-*
.agents/.wrap-head-*
.agents/.provenance-*
.agents/.ui-pending-*
.agents/.teardown-pending-*
.agents/.writers-live*
.agents/.writers-turn-*
.agents/.writers-kinds-*
.agents/.writers-lock*
.agents/.writers-foreign-cache
.agents/.writers-told-*
.agents/.inbox-seen-*
.agents/.cells-*
.agents/.agents-dismissed
.agents/.agents-dismissed.lock
.agents/.cell-markers-*
.agents/.outside-runs-*
.agents/.kimi-pending-findings-*
.agents/.workloop-state.json
.agents/.workloop-state.json.lock
.agents/.readout/
.agents/.publish-approved-*
.agents/.keychain-notices.log
# Workloop lane and integration worktrees, nested in the checkout.
.agents/worktrees/
# Each lane's full brief, written by `workloop.py brief`.
.workloop/
# Type declarations Claude Code writes beside a mod each time it loads one, and
# the tsconfig.json it writes to extend them when a session loads the mod's
# folder through CLAUDE_CODE_PLUGIN_DIRS.
.agents/claude/mods/*/.claude-plugin/types/
.agents/claude/mods/*/tsconfig.json

# Per-operator local config and secrets (carry the framework, not the keys).
**/settings.local.json
/CLAUDE.local.md
.env
.env.*

# Python bytecode.
__pycache__/

# macOS Finder metadata.
.DS_Store

# Generated connection files produced by .agents/mcp.py from .agents/mcp.json.
# OpenCode's config also renders the permission rules and personas.
/.mcp.json
/.kimi-code/mcp.json
/.codex/config.toml
/.opencode/opencode.json
/.opencode/instructions/colloid.md

# Reader browser tier. The launch config carries absolute paths, so it is
# machine-local; the extension tree is operator-supplied payload the repository
# wires up but never vendors (uBO Lite is GPL-3.0).
.agents/.playwright-reader.json
.agents/browser-extensions/

# Default browser state: its launch config and proxy session token, which can
# carry proxy credentials, and the profile holding synced session cookies. The
# directory also ignores itself, for a checkout whose rules lack this line.
.agents/.browser/

# Local, per-repo tuned config — copy from config.json.example and tune
.agents/config.json

# The agent's daily work log when hooks.worklog keeps it in the tree.
.agents/worklog/

# Playwright MCP session output — page snapshots and console logs written
# per browser run.
/.playwright-mcp/

# per-workspace scratch typecheck cache written by post-edit-check.sh
**/.tsbuildinfo-claude
.agents/eval/*/runs.tsv

# Screenshots another tool writes into this root. Scoped to the root and to
# that one prefix: a broad `*.png` rule would also swallow an image a document
# here means to carry, and this repository's own images are none.
/favours-app-*.png

# Operator records. They name the operator's clients and machines, so each is
# local; where a tracked `.example` sits beside one, copy it to start the record.
.agents/decisions.md
.agents/breadcrumbs.md
.agents/debt-log.private.md
.agents/knowledge/index.md
.agents/knowledge/research/*
!.agents/knowledge/research/example-entry.md
.agents/knowledge/transcripts/
.agents/fixtures/
.agents/eval/review-harness/fixtures-extra/
.agents/eval/review-harness/intents/
.agents/eval/review-harness/ref/
.agents/eval/review-harness/results/
.agents/eval/review-harness/judgements.tsv
.agents/eval/review-harness/sources.tsv
docs/notes/
