# Transient hook state — regenerated at runtime, never committed.
.agents/.genome-ledger
.agents/.mutagen-ledger
.agents/.sources-ledger
.agents/.compaction-pending
.agents/.wrap-state-*
.agents/.kimi-pending-findings-*

# Per-operator local config and secrets (carry the framework, not the keys).
**/settings.local.json
.env
.env.*

# Python bytecode.
__pycache__/

# macOS Finder metadata.
.DS_Store

# Generated connection files — produced by .agents/sync-mcp.sh and
# .agents/sync-codex.sh from the canonical registry (.agents/mcp.json,
# .agents/lsp.json) + config.json toggles.
/.mcp.json
/.kimi-code/mcp.json
/.codex/config.toml

# Reader browser tier. The launch config carries absolute paths, so it is
# machine-local; the extension tree is operator-supplied payload the repository
# wires up but never vendors (uBO Lite is GPL-3.0).
.agents/.playwright-reader.json
.agents/browser-extensions/

# Local, per-repo tuned config — copy from config.json.example and tune
.agents/config.json

# Playwright MCP session output — page snapshots and console logs written
# per browser run.
/.playwright-mcp/

# per-workspace scratch typecheck cache written by post-edit-check.sh
**/.tsbuildinfo-claude
.agents/eval/*/runs.tsv

# Screenshots another tool writes into this root. Scoped to the root and to
# that one prefix: a broad `*.png` rule would also swallow an image a document
# here means to carry, and this repository's own images are none.
/donezo-*.png
