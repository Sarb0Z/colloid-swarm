# Transient hook state — regenerated at runtime, never committed.
.agents/.genome-ledger
.agents/.mutagen-ledger
.agents/.sources-ledger
.agents/.compaction-pending
.agents/.wrap-prompted
.agents/.learning-prompted

# Per-operator local config and secrets (carry the framework, not the keys).
**/settings.local.json
.env
.env.*

# Server-audit run artifacts — infra telemetry + credentials never get committed.
audit-results/
**/*.creds
__pycache__/
